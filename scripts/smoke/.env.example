SANDWICH_PUBLIC_BASE_URL=http://127.0.0.1:18080
SANDWICH_ADMIN_BASE_URL=http://127.0.0.1:18080/admin-api
SANDWICH_FRONT_BASE_URL=http://127.0.0.1:18080/front-api
SANDWICH_OPEN_BASE_URL=http://127.0.0.1:18080/open-api
SANDWICH_OPEN_CONTEXT_PATH=/open-api
SANDWICH_SMOKE_TIMEOUT=10
SANDWICH_SMOKE_TOKEN_HEADER=Access-Token

# Set a real runtime token when running authenticated admin or storage smoke checks.
SANDWICH_SMOKE_ACCESS_TOKEN=
SANDWICH_SMOKE_ADMIN_TOKEN=
SANDWICH_SMOKE_REQUIRE_AUTH=false

# Upload smoke is disabled by default because it writes data.
SANDWICH_SMOKE_STORAGE_UPLOAD=false
SANDWICH_SMOKE_STORAGE_FILE=

# Set real Open API credentials to run signed open-api smoke checks.
SANDWICH_SMOKE_OPEN_API_KEY=
SANDWICH_SMOKE_OPEN_API_SECRET=
SANDWICH_SMOKE_REQUIRE_OPEN_API=false

# Set three distinct direct instance URLs for cache sync smoke checks.
SANDWICH_ADMIN_API_A_BASE_URL=
SANDWICH_ADMIN_API_B_BASE_URL=
SANDWICH_ADMIN_API_C_BASE_URL=
SANDWICH_FRONT_API_A_BASE_URL=
SANDWICH_FRONT_API_B_BASE_URL=
SANDWICH_FRONT_API_C_BASE_URL=
SANDWICH_OPEN_API_A_BASE_URL=
SANDWICH_OPEN_API_B_BASE_URL=
SANDWICH_OPEN_API_C_BASE_URL=
