# Sandwich deployed-environment verification and load-test variables.
# Copy to .env.smoke for smoke scripts, or .env.load for load scripts.

SANDWICH_PUBLIC_BASE_URL=http://127.0.0.1:18080
SANDWICH_ADMIN_BASE_URL=http://127.0.0.1:18080/admin-api
SANDWICH_FRONT_BASE_URL=http://127.0.0.1:18080/front-api
SANDWICH_OPEN_BASE_URL=http://127.0.0.1:18080/open-api
SANDWICH_OPEN_CONTEXT_PATH=/open-api

SANDWICH_SMOKE_TIMEOUT=10
SANDWICH_SMOKE_TOKEN_HEADER=Access-Token

# Set real runtime credentials for authenticated smoke and load checks.
SANDWICH_SMOKE_ACCESS_TOKEN=
SANDWICH_SMOKE_ADMIN_TOKEN=
SANDWICH_SMOKE_REQUIRE_AUTH=false
SANDWICH_SMOKE_FRONT_ACCESS_TOKEN=
SANDWICH_SMOKE_FRONT_REFRESH_TOKEN=

# Upload smoke is disabled by default because it writes data.
SANDWICH_SMOKE_STORAGE_UPLOAD=false
SANDWICH_SMOKE_STORAGE_FILE=

# Set real Open API credentials to run signed open-api smoke and load checks.
SANDWICH_SMOKE_OPEN_API_KEY=
SANDWICH_SMOKE_OPEN_API_SECRET=
SANDWICH_SMOKE_REQUIRE_OPEN_API=false

# Three distinct direct instance URLs for cache sync smoke checks.
SANDWICH_ADMIN_API_A_BASE_URL=
SANDWICH_ADMIN_API_B_BASE_URL=
SANDWICH_ADMIN_API_C_BASE_URL=
SANDWICH_FRONT_API_A_BASE_URL=
SANDWICH_FRONT_API_B_BASE_URL=
SANDWICH_FRONT_API_C_BASE_URL=
SANDWICH_OPEN_API_A_BASE_URL=
SANDWICH_OPEN_API_B_BASE_URL=
SANDWICH_OPEN_API_C_BASE_URL=

# Optional cache-sync fixtures for by-id caches. Leave blank to mark the cache as SKIP.
SANDWICH_CACHE_SYNC_USER_ID=
SANDWICH_CACHE_SYNC_ROLE_ID=
SANDWICH_CACHE_SYNC_MENU_ID=
SANDWICH_CACHE_SYNC_DEPARTMENT_ID=
SANDWICH_CACHE_SYNC_DICT_ID=
SANDWICH_CACHE_SYNC_STORAGE_OBJECT_ID=

# k6 load-test settings.
# Format: duration:target,duration:target
SANDWICH_LOAD_STAGES=30s:5,2m:20,30s:0
SANDWICH_LOAD_INCLUDE_PRE_AUTH=true
SANDWICH_LOAD_THINK_TIME_SECONDS=1
SANDWICH_LOAD_FAILED_THRESHOLD=rate<0.01
SANDWICH_LOAD_P95_THRESHOLD=p(95)<1000
SANDWICH_LOAD_P99_THRESHOLD=p(99)<2000
SANDWICH_LOAD_REPORT_DIR=reports/load
SANDWICH_LOAD_K6_IMAGE=sandwish/k6:dev
SANDWICH_LOAD_USE_LOCAL_K6=false
SANDWICH_LOAD_DOCKER_NETWORK=host
