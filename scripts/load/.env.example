SANDWICH_PUBLIC_BASE_URL=http://127.0.0.1:18080
SANDWICH_ADMIN_BASE_URL=http://127.0.0.1:18080/admin-api
SANDWICH_FRONT_BASE_URL=http://127.0.0.1:18080/front-api
SANDWICH_OPEN_BASE_URL=http://127.0.0.1:18080/open-api
SANDWICH_OPEN_CONTEXT_PATH=/open-api

# Reuse smoke credentials when available.
SANDWICH_SMOKE_TOKEN_HEADER=Access-Token
SANDWICH_SMOKE_ACCESS_TOKEN=
SANDWICH_SMOKE_ADMIN_TOKEN=
SANDWICH_SMOKE_OPEN_API_KEY=
SANDWICH_SMOKE_OPEN_API_SECRET=

# Format: duration:target,duration:target
SANDWICH_LOAD_STAGES=30s:5,2m:20,30s:0
SANDWICH_LOAD_THINK_TIME_SECONDS=1
SANDWICH_LOAD_FAILED_THRESHOLD=rate<0.01
SANDWICH_LOAD_P95_THRESHOLD=p(95)<1000
SANDWICH_LOAD_P99_THRESHOLD=p(99)<2000
SANDWICH_LOAD_REPORT_DIR=reports/load
